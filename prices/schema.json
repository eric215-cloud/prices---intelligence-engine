{
  "title": "PRICES record schemas (JSON-Schema subset; validated by prices/schema.py)",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "date": {"type": "string", "format": "date"},
    "date_or_null": {"type": ["string", "null"], "format": "date"},
    "text": {"type": "string", "minLength": 1},

    "condition": {
      "x-hint": "a condition must be exactly one of: {\"holds\": id} | {\"metric\": id, \"gte\": number} | {\"all\": [..]} | {\"any\": [..]} | {\"not\": {\"holds\": id}}",
      "oneOf": [
        {"type": "object", "required": ["holds"], "additionalProperties": false,
         "properties": {"holds": {"$ref": "#/$defs/id"}}},
        {"type": "object", "required": ["metric", "gte"], "additionalProperties": false,
         "properties": {"metric": {"$ref": "#/$defs/id"}, "gte": {"type": "number"}}},
        {"type": "object", "required": ["all"], "additionalProperties": false,
         "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}}},
        {"type": "object", "required": ["any"], "additionalProperties": false,
         "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}}},
        {"type": "object", "required": ["not"], "additionalProperties": false,
         "properties": {"not": {"type": "object", "required": ["holds"], "additionalProperties": false,
                                "properties": {"holds": {"$ref": "#/$defs/id"}}}}}
      ]
    },

    "entity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "name"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["program", "card", "currency", "status", "benefit", "action", "capability",
                          "organization", "network_tier"]},
        "name": {"$ref": "#/$defs/text"},
        "program": {"$ref": "#/$defs/id"},
        "network": {"$ref": "#/$defs/id"},
        "card": {"$ref": "#/$defs/card_roles"},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "tags": {"type": "array", "items": {"type": "string"}},
        "how": {"type": "string"},
        "economics": {"type": "object"},
        "notes": {"type": "string"}
      }
    },

    "role": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9_.-]*$"},

    "card_roles": {
      "x-doc": "Who plays which role for a card product. A missing key means not recorded; null means recorded as none. Descriptive only: the engine never derives anything from these.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "cobrand_partner": {"$ref": "#/$defs/role"},
        "program_manager": {"$ref": "#/$defs/role"},
        "issuer": {"$ref": "#/$defs/role"},
        "capital_provider": {"$ref": "#/$defs/role"},
        "network": {"$ref": "#/$defs/role"},
        "network_tier": {"$ref": "#/$defs/role"},
        "annual_fee_usd": {"type": "number"}
      }
    },

    "retention": {
      "type": "object", "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["fixed_term", "while_qualified", "unknown"]},
        "retain_when": {"$ref": "#/$defs/condition"},
        "note": {"type": "string"}
      }
    },

    "date_or_unknown": {
      "x-doc": "A real date, or the word unknown. Never guess a date: write unknown.",
      "type": "string", "pattern": "^(unknown|[0-9]{4}-[0-9]{2}-[0-9]{2})$"},

    "amount": {
      "type": "object", "additionalProperties": false, "required": ["amount", "unit"],
      "properties": {"amount": {"type": "number"}, "unit": {"$ref": "#/$defs/text"}}
    },

    "earn": {
      "x-doc": "Public terms of an earned benefit: reach `threshold` on `measure` within one `period` on the card named in `when`. Says nothing about any person.",
      "type": "object", "additionalProperties": false,
      "required": ["measure", "period", "threshold", "activation", "term"],
      "properties": {
        "measure": {"$ref": "#/$defs/id"},
        "period": {"enum": ["calendar_year"]},
        "threshold": {"type": "number"},
        "unit": {"type": "string"},
        "activation": {"enum": ["automatic", "required"]},
        "activation_action": {"$ref": "#/$defs/id"},
        "term": {
          "type": "object", "additionalProperties": false, "required": ["ends"],
          "properties": {
            "ends": {"enum": ["fixed", "not_stated"]},
            "year_offset": {"type": "integer"},
            "month": {"type": "integer"},
            "day": {"type": "integer"},
            "month_end": {"type": "boolean"},
            "note": {"type": "string"}
          }
        },
        "allowance": {"$ref": "#/$defs/amount"}
      }
    },

    "reading": {
      "x-doc": "One observation of cumulative progress within a cycle. Append-only: corrections supersede, never overwrite.",
      "type": "object", "additionalProperties": false,
      "required": ["id", "value", "observed_on", "state"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "value": {"type": "number"},
        "value_kind": {"enum": ["exact", "at_least"]},
        "observed_on": {"$ref": "#/$defs/date_or_unknown"},
        "final": {"type": "boolean"},
        "state": {"enum": ["confirmed", "unconfirmed", "superseded"]},
        "confirmed_by": {"type": "string"},
        "confirmed_on": {"$ref": "#/$defs/date"},
        "basis": {"type": "string"},
        "superseded_by": {"$ref": "#/$defs/id"},
        "changeset": {"$ref": "#/$defs/id"}
      }
    },

    "qualification": {
      "x-doc": "One person's progress on one measure, on one of their own accounts, in one qualifying cycle.",
      "type": "object", "additionalProperties": false,
      "required": ["id", "account", "measure", "cycle", "readings"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "account": {"$ref": "#/$defs/id"},
        "measure": {"$ref": "#/$defs/id"},
        "cycle": {"type": "string", "pattern": "^[0-9]{4}$"},
        "readings": {"type": "array", "items": {"$ref": "#/$defs/reading"}},
        "notes": {"type": "string"}
      }
    },

    "usage_event": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "amount", "used_on", "state"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "amount": {"type": "number"},
        "used_on": {"$ref": "#/$defs/date_or_unknown"},
        "state": {"enum": ["confirmed", "unconfirmed", "superseded"]},
        "confirmed_by": {"type": "string"},
        "confirmed_on": {"$ref": "#/$defs/date"},
        "basis": {"type": "string"},
        "superseded_by": {"$ref": "#/$defs/id"},
        "changeset": {"$ref": "#/$defs/id"}
      }
    },

    "entitlement": {
      "x-doc": "One earned benefit actually on one person's account, from one qualifying cycle, with its own dates.",
      "type": "object", "additionalProperties": false,
      "required": ["id", "rule", "entity", "account", "cycle", "state", "effective_from", "expires_on"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "rule": {"$ref": "#/$defs/id"},
        "entity": {"$ref": "#/$defs/id"},
        "account": {"$ref": "#/$defs/id"},
        "cycle": {"type": "string", "pattern": "^[0-9]{4}$"},
        "state": {"enum": ["confirmed", "unconfirmed", "superseded"]},
        "effective_from": {"$ref": "#/$defs/date_or_unknown"},
        "expires_on": {"$ref": "#/$defs/date_or_unknown"},
        "ended_on": {"$ref": "#/$defs/date"},
        "end_reason": {"type": "string"},
        "allowance": {"$ref": "#/$defs/amount"},
        "usage": {"type": "array", "items": {"$ref": "#/$defs/usage_event"}},
        "confirmed_by": {"type": "string"},
        "confirmed_on": {"$ref": "#/$defs/date"},
        "basis": {"type": "string"},
        "notes": {"type": "string"}
      }
    },

    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["verified", "unverified", "retired"]},
        "last_verified": {"$ref": "#/$defs/date"},
        "review_by": {"$ref": "#/$defs/date"}
      }
    },

    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "output", "when", "summary", "evidence", "verification"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["grants", "acquire", "transfer", "baseline", "excludes", "earns"]},
        "output": {"$ref": "#/$defs/id"},
        "when": {"$ref": "#/$defs/condition"},
        "summary": {"$ref": "#/$defs/text"},
        "superseded_by": {"$ref": "#/$defs/id"},
        "earn": {"$ref": "#/$defs/earn"},
        "retention": {"$ref": "#/$defs/retention"},
        "transfer": {"type": "object", "additionalProperties": false, "required": ["from"],
                     "properties": {"from": {"$ref": "#/$defs/id"}, "ratio": {"type": "string"}, "note": {"type": "string"}}},
        "valid_from": {"$ref": "#/$defs/date"},
        "valid_to": {"$ref": "#/$defs/date_or_null"},
        "restrictions": {"type": "array", "items": {"type": "string"}},
        "open_questions": {"type": "array", "items": {"type": "string"}},
        "value_note": {"type": "string"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "verification": {"$ref": "#/$defs/verification"}
      }
    },

    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "url", "title", "publisher", "source_type", "retrieved_on", "summary"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "url": {"$ref": "#/$defs/text"},
        "title": {"$ref": "#/$defs/text"},
        "publisher": {"$ref": "#/$defs/text"},
        "source_type": {"enum": ["official", "reputable_secondary", "community", "owner_document", "synthetic"]},
        "retrieved_on": {"$ref": "#/$defs/date"},
        "summary": {"$ref": "#/$defs/text"},
        "applies_to": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "notes": {"type": "string"}
      }
    },

    "holding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "entity", "state"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "entity": {"$ref": "#/$defs/id"},
        "state": {"enum": ["confirmed", "unconfirmed", "ended"]},
        "valid_from": {"$ref": "#/$defs/date"},
        "valid_to": {"$ref": "#/$defs/date_or_null"},
        "acquired_via": {"$ref": "#/$defs/id"},
        "acquired_on": {"$ref": "#/$defs/date"},
        "confirmed_on": {"$ref": "#/$defs/date"},
        "confirmed_by": {"type": "string"},
        "quantity": {"type": "number"},
        "notes": {"type": "string"}
      }
    },

    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "value", "as_of", "state"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "value": {"type": "number"},
        "as_of": {"$ref": "#/$defs/date"},
        "state": {"enum": ["confirmed", "unconfirmed"]},
        "confirmed_by": {"type": "string"},
        "notes": {"type": "string"}
      }
    },

    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "synthetic", "owner"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"$ref": "#/$defs/text"},
        "synthetic": {"type": "boolean"},
        "owner": {"$ref": "#/$defs/text"},
        "valuations": {"type": "object"},
        "notes": {"type": "string"}
      }
    },

    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "created_on", "proposed_rule", "evidence", "search_path", "open_questions"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["proposed", "promoted", "rejected"]},
        "created_on": {"$ref": "#/$defs/date"},
        "run": {"$ref": "#/$defs/id"},
        "proposed_entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
        "proposed_rule": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "kind", "output", "when", "summary"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "kind": {"enum": ["grants", "acquire", "transfer", "baseline", "excludes", "earns"]},
            "output": {"$ref": "#/$defs/id"},
            "when": {"$ref": "#/$defs/condition"},
            "summary": {"$ref": "#/$defs/text"},
            "superseded_by": {"$ref": "#/$defs/id"},
            "earn": {"$ref": "#/$defs/earn"},
            "retention": {"$ref": "#/$defs/retention"},
            "transfer": {"type": "object"},
            "valid_from": {"$ref": "#/$defs/date"},
            "valid_to": {"$ref": "#/$defs/date_or_null"},
            "restrictions": {"type": "array", "items": {"type": "string"}},
            "value_note": {"type": "string"}
          }
        },
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "search_path": {"type": "array", "items": {"type": "string"}},
        "open_questions": {"type": "array", "items": {"type": "string"}},
        "mentions": {"type": "array", "items": {"type": "string"}},
        "review": {"type": "object"}
      }
    },

    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "summary", "tags", "checked_on", "valid_to", "url", "publisher"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["promotion", "availability"]},
        "summary": {"$ref": "#/$defs/text"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "checked_on": {"$ref": "#/$defs/date"},
        "valid_from": {"$ref": "#/$defs/date"},
        "valid_to": {"$ref": "#/$defs/date"},
        "url": {"$ref": "#/$defs/text"},
        "publisher": {"$ref": "#/$defs/text"},
        "confirmed_by": {"type": "string"},
        "notes": {"type": "string"}
      }
    },

    "discovery_run": {
      "type": "object",
      "required": ["id", "date", "mode", "profile", "executor", "tasks", "steps", "cells"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "date": {"$ref": "#/$defs/date"},
        "mode": {"enum": ["forward", "backward", "bridge", "exploratory"]},
        "profile": {"$ref": "#/$defs/id"},
        "executor": {"$ref": "#/$defs/text"},
        "tasks": {"type": "array"},
        "steps": {"type": "array", "items": {"type": "object", "required": ["query", "finding"]}},
        "cells": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["cell", "outcome"],
          "properties": {"cell": {"type": "string"},
                         "outcome": {"enum": ["found", "nothing_found", "inconclusive"]},
                         "candidates": {"type": "array", "items": {"$ref": "#/$defs/id"}},
                         "note": {"type": "string"}}}}
      }
    },

    "attestation": {
      "type": "object", "additionalProperties": false,
      "required": ["by", "on", "statement"],
      "properties": {"by": {"$ref": "#/$defs/text"}, "on": {"$ref": "#/$defs/date"}, "statement": {"$ref": "#/$defs/text"}}
    },

    "changeset": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "op", "author", "date", "reason"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "op": {"enum": ["confirm_rule", "revise_rule", "flag_rule", "retire_rule", "add_evidence",
                        "add_entity", "revise_entity", "add_candidate", "promote_candidate", "reject_candidate",
                        "revert_changeset",
                        "set_holding", "end_holding", "set_metric",
                        "record_progress", "record_entitlement", "revise_entitlement", "record_usage", "correct_entry",
                        "record_discovery_run", "add_observation", "prune_observations"]},
        "author": {"$ref": "#/$defs/text"},
        "date": {"$ref": "#/$defs/date"},
        "reason": {"$ref": "#/$defs/text"},
        "target": {"$ref": "#/$defs/id"},
        "profile": {"$ref": "#/$defs/id"},
        "data": {"type": "object"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "attestation": {"$ref": "#/$defs/attestation"}
      }
    }
  }
}
